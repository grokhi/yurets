# Единственный рабочий источник — Plex Media Server (не app.plex.tv).
# Можно заполнить эти поля или выполнить python -m src.plex_link.
YURETS_PLEX_URL=
YURETS_PLEX_TOKEN=
YURETS_PLEX_LIBRARY_ID=
# Необязательно: проверка machineIdentifier выбранного сервера.
YURETS_PLEX_SERVER_ID=

# День расписания. Для UTC укажите UTC; для Москвы — Europe/Moscow.
YURETS_TIMEZONE=Asia/Tokyo
# Пустой список: каждый день новый детерминированный порядок всех альбомов.
# Ручной список ratingKey альбомов: ["123", "456"] (в указанном порядке).
YURETS_PLEX_ALBUM_IDS=[]

YURETS_DATA_DIR=./data
YURETS_ASSUMED_BITRATE_KBPS=192
YURETS_BROADCAST_CHUNK_SIZE=4096
YURETS_SUBSCRIBER_QUEUE_CHUNKS=256
YURETS_FFMPEG_PATH=ffmpeg

# /stats: логин radio. Без пароля статистика закрыта.
YURETS_ADMIN_PASSWORD=
YURETS_ANALYTICS_RETENTION_DAYS=90
# Уже включено по умолчанию. Для локальной разработки по HTTP можно задать false.
# YURETS_SECURE_COOKIES=true
# Укажите только адреса реальных reverse proxy, иначе оставьте [].
# Запускайте Uvicorn с --no-proxy-headers: IP проверяет само приложение.
YURETS_TRUSTED_PROXY_CIDRS=[]
# По умолчанию используется geoip/dbip-country-lite.mmdb в каталоге приложения.
# База загружается при сборке Docker-образа / командой python -m src.geoip_update.
# Для своей Country MMDB можно переопределить путь:
# YURETS_GEOIP_DATABASE=/data/custom-country.mmdb

# Старые YURETS_TELEGRAM_* и YURETS_SCHEDULE_JSON сохранены в коде,
# но не используются рабочим Plex-потоком. Telegram не запускается.
